{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-inference-storage-showcase/tier_profile.schema.json",
  "title": "TierProfile",
  "type": "object",
  "additionalProperties": true,
  "required": ["contract_version", "generated_at", "env_id", "profiles"],
  "properties": {
    "contract_version": {"const": 1},
    "generated_at": {"type": "string"},
    "env_id": {"type": "string"},
    "source_csv": {"type": "string"},
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "available": {"type": "boolean"},
          "skipped": {"type": "boolean"},
          "reason": {"type": "string"},
          "unavailable_reason": {"type": "string"},
          "p50_ms": {"type": "number", "minimum": 0},
          "p95_ms": {"type": "number", "minimum": 0},
          "p99_ms": {"type": "number", "minimum": 0},
          "bandwidth_MBps": {"type": "number", "minimum": 0},
          "bandwidth_GBps": {"type": "number", "minimum": 0},
          "cpu_us_per_op": {"type": "number", "minimum": 0},
          "page_cache_policy": {"type": "string"},
          "filesystem": {"type": "string"},
          "mount_options": {"type": "string"},
          "kernel": {"type": "string"},
          "driver": {"type": "string"},
          "selected_profile_mode": {"type": "string", "enum": ["p50", "p95", "p99"]},
          "selected_latency_ms": {"type": "number", "minimum": 0},
          "transport_name": {"type": "string"},
          "supports_range_read": {"type": "boolean"},
          "supports_gpu_target": {"type": "boolean"},
          "measured_by_tier_profile": {"type": "boolean"},
          "metadata_lookup_p50_ms": {"type": "number", "minimum": 0},
          "metadata_lookup_p95_ms": {"type": "number", "minimum": 0},
          "metadata_lookup_p99_ms": {"type": "number", "minimum": 0},
          "head_object_p50_ms": {"type": "number", "minimum": 0},
          "head_object_p95_ms": {"type": "number", "minimum": 0},
          "head_object_p99_ms": {"type": "number", "minimum": 0},
          "first_byte_p50_ms": {"type": "number", "minimum": 0},
          "first_byte_p95_ms": {"type": "number", "minimum": 0},
          "first_byte_p99_ms": {"type": "number", "minimum": 0},
          "full_get_p50_ms": {"type": "number", "minimum": 0},
          "full_get_p95_ms": {"type": "number", "minimum": 0},
          "full_get_p99_ms": {"type": "number", "minimum": 0},
          "range_get_p50_ms": {"type": "number", "minimum": 0},
          "range_get_p95_ms": {"type": "number", "minimum": 0},
          "range_get_p99_ms": {"type": "number", "minimum": 0},
          "posix_file_read_p50_ms": {"type": "number", "minimum": 0},
          "posix_file_read_p95_ms": {"type": "number", "minimum": 0},
          "posix_file_read_p99_ms": {"type": "number", "minimum": 0},
          "cpu_copy_ms": {"type": "number", "minimum": 0},
          "h2d_copy_ms": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
